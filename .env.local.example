# Laptop development profile: no AWS or Docker required.
LLM_PROVIDER=groq
GROQ_API_KEY=
GROQ_MODEL=qwen/qwen3.8-27b
EMBEDDING_PROVIDER=local
LOCAL_HOST=127.0.0.1
LOCAL_PORT=8765
# Optional OCR executable. Native Windows install is not required for Groq vision fallback.
TESSERACT_CMD=
# Optional model with vision support, used only when local OCR is absent.
GROQ_VISION_MODEL=qwen/qwen3.8-27b
LOCAL_DEVELOPMENT=true

# Optional live tracing: create a Langfuse project and fill these privately.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://cloud.langfuse.com
