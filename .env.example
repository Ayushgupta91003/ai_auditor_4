# Copy to .env in the lab. Never commit real secrets.
POSTGRES_USER=auditor
POSTGRES_PASSWORD=replace-with-a-local-password
POSTGRES_DB=invoices
# Match the password above; URL-encode special characters.
DATABASE_URL=postgresql://auditor:replace-with-a-local-password@postgres:5432/invoices
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=
BEDROCK_MODEL=amazon.nova-lite-v1:0
BEDROCK_RAG_MODEL=amazon.nova-lite-v1:0
BEDROCK_MAX_OUTPUT_TOKENS=4096
BEDROCK_EMBED_MODEL=amazon.titan-embed-text-v2:0
BEDROCK_GUARDRAIL_ID=
BEDROCK_GUARDRAIL_VERSION=
WATCH_ENABLED=true
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=
SERVICE_TOKEN=replace-with-a-random-local-service-token

# Bedrock is the required final lab profile. Groq is an authorized local substitute.
LLM_PROVIDER=bedrock
GROQ_API_KEY=
GROQ_MODEL=qwen/qwen3.8-27b
EMBEDDING_PROVIDER=bedrock
LANGFUSE_BASE_URL=https://cloud.langfuse.com
POSTGRES_HOST_PORT=5432
