# ==============================================================================
# AI Invoice Auditor — environment template
# Copy to .env and fill in. .env is git-ignored; no secret is ever baked into an
# image layer, a Dockerfile or application source.
#   cp .env.example .env
# ==============================================================================

# --- PostgreSQL (durable system of record) ------------------------------------
POSTGRES_USER=auditor
POSTGRES_PASSWORD=replace-with-a-private-password
POSTGRES_DB=invoice_db

# --- AWS Bedrock via LiteLLM --------------------------------------------------
# Leave blank to run the deterministic local handlers (no external model calls).
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION_NAME=us-east-1
BEDROCK_MODEL=bedrock/amazon.nova-lite-v1:0
EMBED_MODEL=bedrock/amazon.titan-embed-text-v2:0

# --- Google ADK ---------------------------------------------------------------
# The Translation and Business Validation agents are ADK agents. With ADK_ENABLED
# false (or without model credentials) they execute their skills deterministically
# through the same MCP tools.
ADK_ENABLED=true

# --- Agent protocols ----------------------------------------------------------
# Empty = in-process dispatch inside the agent container. Set a URL to move an
# agent or the tool server into its own process/container without code changes.
MCP_SERVER_URL=
A2A_BASE_URL=

# --- Observability (LangFuse) -------------------------------------------------
# Start the backend with:  docker compose --profile observability up -d
# Then create a project at http://localhost:3000 and paste its keys here.
# Leaving the keys blank traces to structured logs instead.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=http://langfuse:3000
LANGFUSE_NEXTAUTH_SECRET=replace-with-a-random-secret
LANGFUSE_SALT=change_me_langfuse_salt

# --- Runtime behaviour --------------------------------------------------------
# Refuse to start when PostgreSQL or mock-erp is unreachable.
STRICT_STARTUP=true
WATCHDOG_POLL_INTERVAL=4.0
CACHE_TTL_SECONDS=604800
