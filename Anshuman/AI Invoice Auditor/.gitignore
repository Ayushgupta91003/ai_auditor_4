# Secrets — never commit
.env
.env.*
!.env.example

# Python
__pycache__/
*.pyc
*.pyo
.venv/
venv/

# Local artifacts
*.sqlite
*.log
logs/

# Private incoming documents and generated audit output stay local.
/data/incoming/*
!/data/incoming/.gitkeep
/outputs/reports/*
!/outputs/reports/.gitkeep
*.sqlite3
*.db
